# Copy to .env and fill in. Never commit .env itself — it is gitignored.

# Connection template shared by the control database and every tenant database.
# Only the database name in the path differs per connection, so point this at the
# Postgres *server*; the role must be able to CREATE DATABASE, since a tenant
# database is provisioned per signup (see lib/provisionTenant.ts).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/postgres"

# Shared control database: users, sessions, and which tenant database each user owns.
CONTROL_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vinyl_control"

# Optional. Fallback Discogs API token, used when a user hasn't set their own on the
# account page. Leave BLANK unless you have one — a blank value is understood as
# "no token" and the tests that need one skip cleanly with an explanatory notice.
# Do NOT put a placeholder string here: anything non-blank is treated as a real token
# and those tests will attempt real API calls and fail on 401.
#
# Free token: https://www.discogs.com/settings/developers
#
# Without it: Discogs search and cover-image lookup are unavailable in the app, and
# `npm run test:contract` plus the one Discogs e2e journey skip. Everything else —
# all of `npm test` and the rest of `npm run test:integration` — runs without it,
# because MSW serves recorded fixtures instead of calling Discogs.
DISCOGS_TOKEN=""

# Password for the /admin dashboard (username is always "admin"). Blank matches this
# app's original hardcoded-for-local-dev behavior. Set a real value before deploying
# anywhere beyond localhost.
ADMIN_PASSWORD=""
